  },
  "homepage": "https://github.com/node777/grain-atlas#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@fontsource/public-sans": "^5.1.1",
    "@fontsource/source-code-pro": "^5.1.1",
    "@fontsource/tiro-devanagari-sanskrit": "^5.1.0",
